rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'LNG9C1ewCLU3yRJPsKYUlFEpIeE3';
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /customCoutureRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone'])
        && request.resource.data.status == 'new';
      allow get, list, update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'message'])
        && request.resource.data.status == 'new';
      allow get, list, update, delete: if isAdmin();
    }

    match /newsletterSubscribers/{subscriberId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
